{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pgmcp.local/schema/test-v1",
  "title": "test/v1",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "targets",
        "args",
        "execution_context"
      ],
      "properties": {
        "operation": {
          "$ref": "#/$defs/capability_id"
        },
        "targets": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/absolute_path"
          }
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "execution_context": {
          "$ref": "#/$defs/execution_context"
        }
      }
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decision",
            "external_tools"
          ],
          "properties": {
            "decision": {
              "$ref": "#/$defs/passed"
            },
            "external_tools": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/external_tool_identity"
              }
            },
            "evidence": {
              "$ref": "#/$defs/native_evidence"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decision",
            "external_tools",
            "evidence"
          ],
          "properties": {
            "decision": {
              "$ref": "#/$defs/failed"
            },
            "external_tools": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/external_tool_identity"
              }
            },
            "evidence": {
              "$ref": "#/$defs/native_evidence"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decision",
            "external_tools"
          ],
          "properties": {
            "decision": {
              "$ref": "#/$defs/unavailable"
            },
            "external_tools": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/external_tool_identity"
              }
            },
            "evidence": {
              "$ref": "#/$defs/native_evidence"
            }
          }
        },
        {
          "$ref": "#/$defs/invalid_request"
        }
      ]
    },
    "external_tool_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_id",
        "version"
      ],
      "properties": {
        "tool_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "version": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "native_evidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "data"
          ],
          "properties": {
            "format": {
              "const": "text"
            },
            "data": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "data"
          ],
          "properties": {
            "format": {
              "const": "json"
            },
            "data": {}
          }
        }
      ]
    },
    "request_validation_issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location",
        "code"
      ],
      "properties": {
        "location": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ]
          }
        },
        "code": {
          "enum": [
            "missing_field",
            "wrong_type",
            "invalid_value",
            "unknown_field"
          ]
        }
      }
    },
    "invalid_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "details"
      ],
      "properties": {
        "reason": {
          "const": "invalid_request"
        },
        "details": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/request_validation_issue"
          }
        }
      }
    },
    "passed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "message"
      ],
      "properties": {
        "status": {
          "const": "passed"
        },
        "message": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "failed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "message"
      ],
      "properties": {
        "status": {
          "const": "failed"
        },
        "message": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "message"
      ],
      "properties": {
        "status": {
          "const": "unavailable"
        },
        "reason": {
          "enum": [
            "dependency_unavailable",
            "unsupported_input",
            "invalid_configuration",
            "execution_error",
            "invalid_result"
          ]
        },
        "message": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "absolute_path": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "not": {
            "pattern": "\u0000"
          }
        },
        {
          "pattern": "^(?:/|[A-Za-z]:[\\\\/]|\\\\\\\\[^\\\\/]+[\\\\/][^\\\\/]+)[\\s\\S]*$(?![\\s\\S])"
        }
      ]
    },
    "absolute_file_path": {
      "allOf": [
        {
          "$ref": "#/$defs/absolute_path"
        },
        {
          "not": {
            "pattern": "(?:[\\\\/]|(?:^|[\\\\/])\\.{1,2})$"
          }
        }
      ]
    },
    "capability_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$(?![\\s\\S])"
    },
    "execution_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scratch_directory"
      ],
      "properties": {
        "scratch_directory": {
          "$ref": "#/$defs/absolute_path"
        }
      }
    }
  }
}
