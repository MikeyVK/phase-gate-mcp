{% extends "shared/templates/bases/tier2_markdown_document.jinja2" %}
{% import "shared/templates/patterns/markdown/sections.jinja2" as sections %}
{% import "shared/templates/patterns/markdown/links.jinja2" as links %}

{% macro validation_spec(spec) -%}
{%- set selected = namespace(parts=[
    '**Type:** ' ~ spec.type
]) -%}
{%- if spec.file is defined -%}
{%- set selected.parts = selected.parts + ['**File:** ' ~ (spec.file | tojson)] -%}
{%- endif -%}
{%- if spec.dir is defined -%}
{%- set selected.parts = selected.parts + ['**Directory:** ' ~ (spec.dir | tojson), '**Pattern:** ' ~ (spec.pattern | tojson)] -%}
{%- endif -%}
{%- if spec.text is defined -%}
{%- set selected.parts = selected.parts + ['**Text:** ' ~ (spec.text | tojson)] -%}
{%- endif -%}
{%- if spec.path is defined -%}
{%- set selected.parts = selected.parts + ['**Path:** ' ~ (spec.path | tojson)] -%}
{%- endif -%}
{{ sections.join(selected.parts) }}
{%- endmacro %}

{% macro deliverable(item, level=4) -%}
{%- set selected = namespace(parts=[
    sections.heading(item.id, level), item.description | text_block
]) -%}
{%- if item.owner is defined -%}
{%- set selected.parts = selected.parts + ['**Owner:** ' ~ item.owner] -%}
{%- endif -%}
{%- if item.validates is defined -%}
{%- if item.validates is none -%}
{%- set selected.parts = selected.parts + ['**Validates:** null'] -%}
{%- else -%}
{%- set selected.parts = selected.parts + ['**Validates:**', validation_spec(item.validates)] -%}
{%- endif -%}
{%- endif -%}
{{ sections.join(selected.parts) }}
{%- endmacro %}

{% macro work_unit(item) -%}
{%- set selected = namespace(parts=[
    sections.heading(item.id ~ ' — ' ~ item.name, 3),
    sections.labelled('Goal', item.goal)
]) -%}
{%- if item.cycle_number is defined -%}
{%- set selected.parts = selected.parts + ['**Cycle Number:** ' ~ item.cycle_number] -%}
{%- endif -%}
{%- if item.owner is defined -%}
{%- set selected.parts = selected.parts + ['**Owner:** ' ~ item.owner] -%}
{%- endif -%}
{%- for field, title in [('scope_in', 'Scope In'), ('scope_out', 'Scope Out')] -%}
{%- if item[field] is defined -%}
{%- set selected.parts = selected.parts + [
    sections.heading(title, 4), item[field] | text_block
] -%}
{%- endif -%}
{%- endfor -%}
{%- set selected.parts = selected.parts + [sections.heading('Deliverables', 4)] -%}
{%- for entry in item.deliverables -%}
{%- set selected.parts = selected.parts + [deliverable(entry, 5)] -%}
{%- endfor -%}
{%- set selected.parts = selected.parts + [
    sections.heading('Exit Criteria', 4), item.exit_criteria | text_block
] -%}
{%- for field, title in [('dependencies', 'Dependencies'), ('obligations', 'Obligations')] -%}
{%- if item[field] is defined -%}
{%- set selected.parts = selected.parts + [
    sections.heading(title, 4), sections.bullets(item[field])
] -%}
{%- endif -%}
{%- endfor -%}
{%- if item.verification is defined -%}
{%- set selected.parts = selected.parts + [sections.heading('Verification', 4)] -%}
{%- for requirement in item.verification -%}
{%- set selected.parts = selected.parts + [
    sections.heading(requirement.obligation, 5),
    sections.labelled('Method', requirement.method),
    sections.labelled('Expected Result', requirement.expected_result)
] -%}
{%- if requirement.references is defined -%}
{%- set selected.parts = selected.parts + ['**References:**', links.inline_list(requirement.references)] -%}
{%- endif -%}
{%- endfor -%}
{%- endif -%}
{%- if item.risks is defined -%}
{%- set selected.parts = selected.parts + [sections.heading('Risks', 4)] -%}
{%- for risk in item.risks -%}
{%- set selected.parts = selected.parts + [sections.heading(risk.description, 5), risk.mitigation | text_block] -%}
{%- if risk.consequence is defined -%}
{%- set selected.parts = selected.parts + [sections.labelled('Consequence', risk.consequence)] -%}
{%- endif -%}
{%- endfor -%}
{%- endif -%}
{%- if item.stop_conditions is defined -%}
{%- set selected.parts = selected.parts + [sections.heading('Stop Conditions', 4), sections.bullets(item.stop_conditions)] -%}
{%- endif -%}
{{ sections.join(selected.parts) }}
{%- endmacro %}

{% block document_body -%}
{%- set selected = namespace(parts=[sections.prose('Summary', content.summary)]) -%}
{%- if content.dependencies is defined -%}
{%- set selected.parts = selected.parts + [sections.heading('Dependencies'), sections.bullets(content.dependencies)] -%}
{%- endif -%}
{%- if content.risks is defined -%}
{%- set selected.parts = selected.parts + [sections.heading('Risks')] -%}
{%- for risk in content.risks -%}
{%- set selected.parts = selected.parts + [sections.heading(risk.description, 3), risk.mitigation | text_block] -%}
{%- if risk.consequence is defined -%}
{%- set selected.parts = selected.parts + [sections.labelled('Consequence', risk.consequence)] -%}
{%- endif -%}
{%- endfor -%}
{%- endif -%}
{%- if content.milestones is defined -%}
{%- set selected.parts = selected.parts + [sections.heading('Milestones'), sections.bullets(content.milestones)] -%}
{%- endif -%}
{%- set selected.parts = selected.parts + [sections.heading('Work Units')] -%}
{%- for item in content.work_units -%}
{%- set selected.parts = selected.parts + [work_unit(item)] -%}
{%- endfor -%}
{%- if content.phase_deliverables is defined -%}
{%- set selected.parts = selected.parts + [sections.heading('Phase Deliverables')] -%}
{%- for phase in ('design', 'validation', 'documentation') -%}
{%- if content.phase_deliverables[phase] is defined -%}
{%- set selected.parts = selected.parts + [sections.heading(phase | title, 3)] -%}
{%- for item in content.phase_deliverables[phase] -%}
{%- set selected.parts = selected.parts + [deliverable(item, 4)] -%}
{%- endfor -%}
{%- endif -%}
{%- endfor -%}
{%- endif -%}
{{ sections.join(selected.parts) }}
{%- endblock %}
