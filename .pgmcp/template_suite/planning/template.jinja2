{% extends "shared/templates/bases/tier2_markdown_document.jinja2" %}
{% import "shared/templates/patterns/markdown/sections.jinja2" as sections %}
{% import "shared/templates/patterns/markdown/links.jinja2" as links %}

{% macro validation_spec(spec) -%}
**Type:** {{ spec.type }}

**File:** {{ spec.file if spec.file is not none else 'null' }}
{% if spec.text is defined %}
**Text:** {{ spec.text if spec.text is not none else 'null' }}
{% endif %}
{% if spec.path is defined %}
**Path:** {{ spec.path if spec.path is not none else 'null' }}
{% endif %}
{%- endmacro %}

{% macro deliverable(item, level=4) -%}
{{ sections.heading(item.id, level) }}

{{ item.description }}
{% if item.owner is defined %}

**Owner:** {{ item.owner }}
{% endif %}
{% if item.validates is defined %}

**Validates:**{% if item.validates is none %} null
{% else %}
{{ validation_spec(item.validates) }}
{% endif %}
{% endif %}
{%- endmacro %}

{% macro work_unit(item) -%}
{{ sections.heading(item.id ~ ' — ' ~ item.name, 3) }}

**Goal:** {{ item.goal }}
{% if item.cycle_number is defined %}

**Cycle Number:** {{ item.cycle_number }}
{% endif %}
{% if item.owner is defined %}

**Owner:** {{ item.owner }}
{% endif %}
{% if item.scope_in is defined %}

{{ sections.heading('Scope In', 4) }}

{{ item.scope_in }}
{% endif %}
{% if item.scope_out is defined %}

{{ sections.heading('Scope Out', 4) }}

{{ item.scope_out }}
{% endif %}
{{ sections.heading('Deliverables', 4) }}
{% for entry in item.deliverables %}
{{ deliverable(entry, 5) }}
{% endfor %}
{{ sections.heading('Exit Criteria', 4) }}

{{ item.exit_criteria }}
{% if item.dependencies is defined %}

{{ sections.heading('Dependencies', 4) }}

{{ sections.bullets(item.dependencies) }}
{% endif %}
{% if item.obligations is defined %}

{{ sections.heading('Obligations', 4) }}

{{ sections.bullets(item.obligations) }}
{% endif %}
{% if item.verification is defined %}

{{ sections.heading('Verification', 4) }}
{% for requirement in item.verification %}

{{ sections.heading(requirement.obligation, 5) }}

**Method:** {{ requirement.method }}

**Expected Result:** {{ requirement.expected_result }}
{% if requirement.references is defined %}

**References:**

{{ links.inline_list(requirement.references) }}
{% endif %}
{% endfor %}
{% endif %}
{% if item.risks is defined %}

{{ sections.heading('Risks', 4) }}
{% for risk in item.risks %}

{{ sections.heading(risk.description, 5) }}

{{ risk.mitigation }}
{% if risk.consequence is defined %}

**Consequence:** {{ risk.consequence }}
{% endif %}
{% endfor %}
{% endif %}
{% if item.stop_conditions is defined %}

{{ sections.heading('Stop Conditions', 4) }}

{{ sections.bullets(item.stop_conditions) }}
{% endif %}
{%- endmacro %}

{% block document_body %}
{{ sections.prose('Summary', content.summary) }}
{% if content.dependencies is defined %}

{{ sections.heading('Dependencies') }}

{{ sections.bullets(content.dependencies) }}
{% endif %}
{% if content.risks is defined %}

{{ sections.heading('Risks') }}
{% for risk in content.risks %}

{{ sections.heading(risk.description, 3) }}

{{ risk.mitigation }}
{% if risk.consequence is defined %}

**Consequence:** {{ risk.consequence }}
{% endif %}
{% endfor %}
{% endif %}
{% if content.milestones is defined %}

{{ sections.heading('Milestones') }}

{{ sections.bullets(content.milestones) }}
{% endif %}

{{ sections.heading('Work Units') }}
{% for item in content.work_units %}

{{ work_unit(item) }}
{% endfor %}
{% if content.phase_deliverables is defined %}

{{ sections.heading('Phase Deliverables') }}
{% for phase in ('design', 'validation', 'documentation') %}
{% if content.phase_deliverables[phase] is defined %}

{{ sections.heading(phase | title, 3) }}
{% for item in content.phase_deliverables[phase] %}
{{ deliverable(item, 4) }}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}
{% endblock %}
