{% if content.cycle is defined %}

{{ sections.prose('Cycle', content.cycle) }}
{% endif %}
{% if content.validation_status is defined %}

{{ sections.prose('Validation Status', content.validation_status) }}
{% endif %}
{% if content.scope is defined %}

{{ sections.prose('Scope', content.scope) }}
{% endif %}
{% if content.obligations is defined %}

{{ sections.heading('Obligations') }}
