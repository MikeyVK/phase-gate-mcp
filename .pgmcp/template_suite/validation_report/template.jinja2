{% extends "shared/templates/bases/tier2_markdown_document.jinja2" %}
{% import "shared/templates/patterns/markdown/sections.jinja2" as sections %}
{% import "shared/templates/patterns/markdown/links.jinja2" as links %}

{% block document_body -%}
{%- set selected = namespace(parts=[]) -%}
{%- if content.issue_number is defined -%}
{%- set selected.parts = selected.parts + [sections.heading('Issue Number'), sections.issue_refs([content.issue_number])] -%}
{%- endif -%}
{%- for field, title in [
    ('cycle', 'Cycle'), ('validation_status', 'Validation Status'), ('scope', 'Scope')
] -%}
{%- if content[field] is defined -%}
{%- set selected.parts = selected.parts + [sections.prose(title, content[field])] -%}
{%- endif -%}
{%- endfor -%}
{%- if content.obligations is defined -%}
{%- set selected.parts = selected.parts + [sections.heading('Obligations')] -%}
{%- for item in content.obligations -%}
{%- set selected.parts = selected.parts + [
    sections.heading(item.obligation, 3), '**Evidence:**', links.inline_list(item.evidence)
] -%}
{%- if item.outcome is defined -%}
{%- set selected.parts = selected.parts + [sections.labelled('Outcome', item.outcome)] -%}
{%- endif -%}
{%- endfor -%}
{%- endif -%}
{%- if content.evidence is defined -%}
{%- set selected.parts = selected.parts + [sections.heading('Evidence')] -%}
{%- for item in content.evidence -%}
{%- set selected.parts = selected.parts + [
    sections.heading(item.claim, 3), item.observation | text_block,
    '**Sources:**', links.inline_list(item.sources)
] -%}
{%- if item.invocation is defined -%}
{%- set selected.parts = selected.parts + [sections.labelled('Invocation', item.invocation)] -%}
{%- endif -%}
{%- if item.observed_result is defined -%}
{%- set selected.parts = selected.parts + [sections.labelled('Observed Result', item.observed_result)] -%}
{%- endif -%}
{%- if item.observed_at is defined -%}
{%- set selected.parts = selected.parts + ['**Observed At:** ' ~ item.observed_at] -%}
{%- endif -%}
{%- endfor -%}
{%- endif -%}
{%- for field, title in [
    ('demonstration', 'Demonstration'), ('preservation', 'Preservation'), ('containment', 'Containment')
] -%}
{%- if content[field] is defined -%}
{%- set selected.parts = selected.parts + [sections.prose(title, content[field])] -%}
{%- endif -%}
{%- endfor -%}
{%- for field, title in [('failures', 'Failures'), ('caveats', 'Caveats')] -%}
{%- if content[field] is defined -%}
{%- set selected.parts = selected.parts + [sections.heading(title), sections.bullets(content[field])] -%}
{%- endif -%}
{%- endfor -%}
{%- if content.risks is defined -%}
{%- set selected.parts = selected.parts + [sections.heading('Risks')] -%}
{%- for item in content.risks -%}
{%- set selected.parts = selected.parts + [sections.heading(item.description, 3), item.mitigation | text_block] -%}
{%- if item.consequence is defined -%}
{%- set selected.parts = selected.parts + [sections.labelled('Consequence', item.consequence)] -%}
{%- endif -%}
{%- endfor -%}
{%- endif -%}
{%- if content.deferred_work is defined -%}
{%- set selected.parts = selected.parts + [sections.heading('Deferred Work')] -%}
{%- for item in content.deferred_work -%}
{%- set selected.parts = selected.parts + [sections.heading(item.description, 3), item.rationale | text_block] -%}
{%- if item.references is defined -%}
{%- set selected.parts = selected.parts + ['**References:**', links.inline_list(item.references)] -%}
{%- endif -%}
{%- endfor -%}
{%- endif -%}
{{ sections.join(selected.parts) }}
{%- endblock %}
