{% extends "shared/templates/bases/tier2_python.jinja2" %}
{% import "shared/templates/patterns/python/signatures.jinja2" as signatures %}
{% block module_documentation %}{{ imports.documentation(content.module_description) }}{% endblock %}
{% block module_imports %}
{{ imports.groups(content.imports | default({}), {"stdlib": [{"kind": "from", "module": "typing", "names": [{"name": "Protocol"}]}]}) }}
{% endblock %}
{% block code -%}
{%- set selected = namespace(members=[]) -%}
{%- for signature in content.methods | default([]) -%}
{%- set selected.members = selected.members + [
    signatures.method(signature, "...") | text_block
] -%}
{%- endfor -%}
{%- set bases = (content.bases | default([])) + ["Protocol"] -%}
{%- set body = imports.documentation(content.class_description) -%}
{%- set body = body ~ "\n\n" ~ (selected.members | join("\n\n"))
    if selected.members else body ~ "\n\npass" -%}
{{ "class " ~ content.class_name ~ "(" ~ (bases | join(", ")) ~ "):\n"
   ~ imports.indented(body, 4) }}
{%- endblock %}
