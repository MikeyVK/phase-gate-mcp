{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Python Protocol content",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "class_name",
    "class_description",
    "module_description"
  ],
  "properties": {
    "class_name": {
      "$ref": "../shared/definitions/python.schema.json#/$defs/Symbol"
    },
    "class_description": {
      "$ref": "../shared/definitions/python.schema.json#/$defs/Text"
    },
    "module_description": {
      "$ref": "../shared/definitions/python.schema.json#/$defs/Prose"
    },
    "imports": {
      "$ref": "../shared/definitions/python.schema.json#/$defs/Imports"
    },
    "bases": {
      "type": "array",
      "items": {
        "$ref": "../shared/definitions/python.schema.json#/$defs/TypeText"
      }
    },
    "methods": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "../shared/definitions/python.schema.json#/$defs/Signature"
          },
          {
            "properties": {
              "parameters": {
                "items": {
                  "$ref": "../shared/definitions/python.schema.json#/$defs/InstanceParameter"
                }
              }
            }
          }
        ]
      }
    }
  }
}
