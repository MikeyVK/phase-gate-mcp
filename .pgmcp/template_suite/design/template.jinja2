{% extends "shared/templates/bases/tier2_markdown_document.jinja2" %}
{% import "shared/templates/patterns/markdown/sections.jinja2" as sections %}
{% import "shared/templates/patterns/markdown/links.jinja2" as links %}

{% block document_body -%}
{%- set selected = namespace(parts=[
    sections.prose('Problem Statement', content.problem_statement),
    sections.heading('Functional Requirements'),
    sections.bullets(content.requirements_functional),
    sections.heading('Nonfunctional Requirements'),
    sections.bullets(content.requirements_nonfunctional)
]) -%}
{%- if content.constraints is defined -%}
{%- set selected.parts = selected.parts + [sections.heading('Constraints'), sections.bullets(content.constraints)] -%}
{%- endif -%}
{%- if content.options is defined -%}
{%- set selected.parts = selected.parts + [sections.heading('Options')] -%}
{%- for item in content.options -%}
{%- set selected.parts = selected.parts + [sections.heading(loop.index ~ '. ' ~ item.name, 3), item.description | text_block] -%}
{%- if item.pros is defined -%}
{%- set selected.parts = selected.parts + ['**Pros:**', sections.bullets(item.pros)] -%}
{%- endif -%}
{%- if item.cons is defined -%}
{%- set selected.parts = selected.parts + ['**Cons:**', sections.bullets(item.cons)] -%}
{%- endif -%}
{%- endfor -%}
{%- endif -%}
{%- for field, title in [('decision', 'Decision'), ('rationale', 'Rationale')] -%}
{%- if content[field] is defined -%}
{%- set selected.parts = selected.parts + [sections.prose(title, content[field])] -%}
{%- endif -%}
{%- endfor -%}
{%- if content.key_decisions is defined -%}
{%- set selected.parts = selected.parts + [sections.heading('Key Decisions')] -%}
{%- for item in content.key_decisions -%}
{%- set selected.parts = selected.parts + [sections.heading(item.decision, 3), item.rationale | text_block] -%}
{%- if item.alternatives is defined -%}
{%- set selected.parts = selected.parts + ['**Alternatives:**', sections.bullets(item.alternatives)] -%}
{%- endif -%}
{%- endfor -%}
{%- endif -%}
{%- if content.questions is defined -%}
{%- set selected.parts = selected.parts + [sections.heading('Questions'), sections.bullets(content.questions)] -%}
{%- endif -%}
{%- for field, title in [('production_design', 'Production Design'), ('test_design', 'Test Design')] -%}
{%- if content[field] is defined -%}
{%- set selected.parts = selected.parts + [sections.prose(title, content[field])] -%}
{%- endif -%}
{%- endfor -%}
{%- if content.contracts is defined -%}
{%- set selected.parts = selected.parts + [sections.heading('Contracts')] -%}
{%- for item in content.contracts -%}
{%- set selected.parts = selected.parts + [sections.heading(item.heading, 3)] -%}
{%- if item.content is defined -%}
{%- set selected.parts = selected.parts + [item.content | text_block] -%}
{%- endif -%}
{%- if item.bullets is defined -%}
{%- set selected.parts = selected.parts + [sections.bullets(item.bullets)] -%}
{%- endif -%}
{%- if item.checklist is defined -%}
{%- set selected.parts = selected.parts + [sections.checklist(item.checklist)] -%}
{%- endif -%}
{%- endfor -%}
{%- endif -%}
{%- for field, title in [
    ('flow', 'Flow'),
    ('state_and_failures', 'State and Failures'),
    ('preservation', 'Preservation'),
    ('transition_and_cleanup', 'Transition and Cleanup')
] -%}
{%- if content[field] is defined -%}
{%- set selected.parts = selected.parts + [sections.prose(title, content[field])] -%}
{%- endif -%}
{%- endfor -%}
{%- if content.validation is defined -%}
{%- set selected.parts = selected.parts + [sections.heading('Validation')] -%}
{%- for item in content.validation -%}
{%- set selected.parts = selected.parts + [
    sections.heading(item.obligation, 3),
    sections.labelled('Method', item.method),
    sections.labelled('Expected Result', item.expected_result)
] -%}
{%- if item.references is defined -%}
{%- set selected.parts = selected.parts + ['**References:**', links.inline_list(item.references)] -%}
{%- endif -%}
{%- endfor -%}
{%- endif -%}
{%- if content.risks is defined -%}
{%- set selected.parts = selected.parts + [sections.heading('Risks')] -%}
{%- for item in content.risks -%}
{%- set selected.parts = selected.parts + [sections.heading(item.description, 3), item.mitigation | text_block] -%}
{%- if item.consequence is defined -%}
{%- set selected.parts = selected.parts + [sections.labelled('Consequence', item.consequence)] -%}
{%- endif -%}
{%- endfor -%}
{%- endif -%}
{%- if content.planning_consequences is defined -%}
{%- set selected.parts = selected.parts + [sections.prose('Planning Consequences', content.planning_consequences)] -%}
{%- endif -%}
{%- if content.sources is defined -%}
{%- set selected.parts = selected.parts + [sections.heading('Sources'), links.inline_list(content.sources)] -%}
{%- endif -%}
{{ sections.join(selected.parts) }}
{%- endblock %}
