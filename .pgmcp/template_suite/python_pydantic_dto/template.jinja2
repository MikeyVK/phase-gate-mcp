{{ imports.groups(content.imports | default({}), {"third_party": [{"kind": "from", "module": "pydantic", "names": names}]}) }}
{% endblock %}
{% block code %}
class {{ content.class_name }}(BaseModel):
    {{ imports.documentation(content.description) }}

    {{ model.model_config(true, content.examples | default([])) }}
