{% extends "shared/templates/bases/tier2_python.jinja2" %}
{% import "shared/templates/patterns/python/pydantic.jinja2" as model %}
{% block module_documentation %}{{ imports.documentation(content.module_description) }}{% endblock %}
{% block module_imports %}
{% set names = [{"name": "BaseModel"}, {"name": "ConfigDict"}] %}
{% if content.fields | default([]) %}{% set names = names + [{"name": "Field"}] %}{% endif %}
{{ imports.groups(content.imports | default({}), {"third_party": [{"kind": "from", "module": "pydantic", "names": names}]}) }}
{% endblock %}
{% block code -%}
{%- set body = [
    imports.documentation(content.class_description),
    model.model_config(true, content.examples | default([]))
] -%}
{%- set rendered_fields = model.fields(content.fields | default([])) | text_block -%}
{%- if rendered_fields -%}
{%- set body = body + [rendered_fields] -%}
{%- endif -%}
{{ "class " ~ content.class_name ~ "(BaseModel):\n"
   ~ imports.indented(body | join("\n\n"), 4) }}
{%- endblock %}
