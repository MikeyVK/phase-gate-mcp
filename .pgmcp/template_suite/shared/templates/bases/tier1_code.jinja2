{% extends "shared/templates/bases/tier0_root.jinja2" %}
{% block content -%}
{% set documentation %}{% block module_documentation required %}{% endblock %}{% endset -%}
{% set imports %}{% block module_imports %}{% endblock %}{% endset -%}
{% set body %}{% block code required %}{% endblock %}{% endset -%}
{% set separator %}{% block code_separator %}{{ '\n\n' }}{% endblock %}{% endset -%}
{% set prefix = [documentation | text_block, imports | text_block] | select | join('\n\n') -%}
{{ [prefix, body | text_block] | select | join(separator) }}
{%- endblock %}
