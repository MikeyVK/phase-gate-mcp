{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authored document decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "rationale"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string"
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
