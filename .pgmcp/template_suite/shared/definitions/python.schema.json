{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Text": {
      "type": "string",
      "minLength": 1
    },
    "Prose": {
      "type": "string"
    },
    "Body": {
      "type": "string",
      "pattern": "\\S"
    },
    "Symbol": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?![\\s\\S])",
      "not": {
        "enum": [
          "False",
          "None",
          "True",
          "and",
          "as",
          "assert",
          "async",
          "await",
          "break",
          "class",
          "continue",
          "def",
          "del",
          "elif",
          "else",
          "except",
          "finally",
          "for",
          "from",
          "global",
          "if",
          "import",
          "in",
          "is",
          "lambda",
          "nonlocal",
          "not",
          "or",
          "pass",
          "raise",
          "return",
          "try",
          "while",
          "with",
          "yield"
        ]
      },
      "$comment": "ASCII-only structured Python identifiers; prose, literals and raw code/type expressions retain their existing Unicode contract."
    },
    "DottedSymbol": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*(?![\\s\\S])",
      "not": {
        "pattern": "(?:^|\\.)(?:False|None|True|and|as|assert|async|await|break|class|continue|def|del|elif|else|except|finally|for|from|global|if|import|in|is|lambda|nonlocal|not|or|pass|raise|return|try|while|with|yield)(?:\\.|$)"
      }
    },
    "TypeText": {
      "type": "string",
      "minLength": 1
    },
    "JSONScalar": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "ImportedName": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/Symbol"
        },
        "alias": {
          "$ref": "#/$defs/Symbol"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "ImportStatement": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "import"
        },
        "module": {
          "$ref": "#/$defs/DottedSymbol"
        },
        "alias": {
          "$ref": "#/$defs/Symbol"
        }
      },
      "required": [
        "kind",
        "module"
      ],
      "additionalProperties": false
    },
    "FromImport": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "from"
        },
        "module": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\.*(?:[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)?(?![\\s\\S])",
          "not": {
            "pattern": "(?:^|\\.)(?:False|None|True|and|as|assert|async|await|break|class|continue|def|del|elif|else|except|finally|for|from|global|if|import|in|is|lambda|nonlocal|not|or|pass|raise|return|try|while|with|yield)(?:\\.|$)"
          }
        },
        "names": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ImportedName"
              },
              "minItems": 1
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "const": "*"
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "additionalProperties": false
                }
              ],
              "items": false,
              "minItems": 1
            }
          ]
        }
      },
      "required": [
        "kind",
        "module",
        "names"
      ],
      "additionalProperties": false
    },
    "Import": {
      "oneOf": [
        {
          "$ref": "#/$defs/ImportStatement"
        },
        {
          "$ref": "#/$defs/FromImport"
        }
      ]
    },
    "Imports": {
      "type": "object",
      "properties": {
        "stdlib": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Import"
          }
        },
        "third_party": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Import"
          }
        },
        "project": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Import"
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "ModelField": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/Symbol",
          "$comment": "ASCII field names exclude leading underscores and exact reserved Pydantic bindings; caller content is never normalized.",
          "not": {
            "anyOf": [
              {
                "pattern": "^_"
              },
              {
                "enum": [
                  "model_config",
                  "Config",
                  "Field",
                  "model_dump",
                  "model_dump_json",
                  "model_validate",
                  "model_validate_json",
                  "model_validate_strings"
                ]
              }
            ]
          }
        },
        "type": {
          "$ref": "#/$defs/TypeText"
        },
        "description": {
          "$ref": "#/$defs/Text"
        },
        "default": {},
        "default_factory": {
          "$ref": "#/$defs/DottedSymbol"
        },
        "ge": {
          "type": "number"
        },
        "gt": {
          "type": "number"
        },
        "le": {
          "type": "number"
        },
        "lt": {
          "type": "number"
        },
        "min_length": {
          "type": "integer",
          "minimum": 0
        },
        "max_length": {
          "type": "integer",
          "minimum": 0
        },
        "pattern": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "name",
        "type",
        "description"
      ],
      "additionalProperties": false,
      "not": {
        "required": [
          "default",
          "default_factory"
        ]
      }
    },
    "Parameter": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/Symbol"
        },
        "type": {
          "$ref": "#/$defs/TypeText"
        },
        "default": {
          "$ref": "#/$defs/JSONScalar"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "additionalProperties": false
    },
    "InstanceParameter": {
      "allOf": [
        {
          "$ref": "#/$defs/Parameter"
        },
        {
          "properties": {
            "name": {
              "$comment": "self is supplied by the instance-method template.",
              "not": {
                "const": "self"
              }
            }
          }
        }
      ]
    },
    "Signature": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/Symbol"
        },
        "description": {
          "$ref": "#/$defs/Text"
        },
        "async": {
          "type": "boolean"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Parameter"
          }
        },
        "return_type": {
          "$ref": "#/$defs/TypeText"
        }
      },
      "required": [
        "name",
        "description",
        "async",
        "parameters",
        "return_type"
      ],
      "additionalProperties": false
    },
    "ConcreteMethod": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/Symbol"
        },
        "description": {
          "$ref": "#/$defs/Text"
        },
        "async": {
          "type": "boolean"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Parameter"
          }
        },
        "return_type": {
          "$ref": "#/$defs/TypeText"
        },
        "body": {
          "$ref": "#/$defs/Body"
        }
      },
      "required": [
        "name",
        "description",
        "async",
        "parameters",
        "return_type",
        "body"
      ],
      "additionalProperties": false
    },
    "NonConstructorMethod": {
      "allOf": [
        {
          "$ref": "#/$defs/ConcreteMethod"
        },
        {
          "properties": {
            "name": {
              "$comment": "A supplied constructor is the sole __init__ declaration.",
              "not": {
                "const": "__init__"
              }
            }
          }
        }
      ]
    },
    "Constructor": {
      "type": "object",
      "properties": {
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Parameter"
          }
        },
        "body": {
          "$ref": "#/$defs/Body"
        }
      },
      "required": [
        "parameters",
        "body"
      ],
      "additionalProperties": false
    },
    "Logging": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "TestCase": {
      "type": "object",
      "properties": {
        "name": {
          "allOf": [
            {
              "$ref": "#/$defs/Symbol"
            },
            {
              "pattern": "^test_"
            }
          ]
        },
        "description": {
          "$ref": "#/$defs/Text"
        },
        "async": {
          "type": "boolean"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Parameter"
          }
        },
        "body": {
          "$ref": "#/$defs/Body"
        },
        "markers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Text"
          }
        }
      },
      "required": [
        "name",
        "description",
        "async",
        "parameters",
        "body"
      ],
      "additionalProperties": false
    },
    "PytestClassName": {
      "allOf": [
        {
          "$ref": "#/$defs/Symbol"
        },
        {
          "$comment": "ASCII pytest classes require the native Test discovery prefix.",
          "pattern": "^Test"
        }
      ]
    },
    "InstanceTestCase": {
      "allOf": [
        {
          "$ref": "#/$defs/TestCase"
        },
        {
          "properties": {
            "parameters": {
              "items": {
                "$ref": "#/$defs/InstanceParameter"
              }
            }
          }
        }
      ]
    },
    "Fixture": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/Symbol"
        },
        "description": {
          "$ref": "#/$defs/Text"
        },
        "async": {
          "type": "boolean"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Parameter"
          }
        },
        "return_type": {
          "$ref": "#/$defs/TypeText"
        },
        "body": {
          "$ref": "#/$defs/Body"
        },
        "decorator": {
          "$ref": "#/$defs/DottedSymbol"
        },
        "scope": {
          "enum": [
            "function",
            "class",
            "module",
            "package",
            "session"
          ]
        },
        "autouse": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "description",
        "async",
        "parameters",
        "return_type",
        "body",
        "decorator"
      ],
      "additionalProperties": false
    }
  }
}
