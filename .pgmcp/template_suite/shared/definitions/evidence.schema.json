{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authored observed evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim",
    "observation",
    "sources"
  ],
  "properties": {
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "observation": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "link.schema.json"
      }
    },
    "invocation": {
      "type": "string"
    },
    "observed_result": {
      "type": "string"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO date-time spelling with optional fractional seconds and Z or numeric offset; Calendar validity is not certified by this schema.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})(?![\\s\\S])"
    }
  }
}
