{% extends "shared/templates/bases/tier2_text_tracking.jinja2" %}
{% import "shared/templates/patterns/markdown/sections.jinja2" as sections %}
{% block tracking_body -%}
{%- set header = content.type ~ ('(' ~ content.scope ~ ')' if content.scope is defined else '')
    ~ ('!' if content.breaking_change is defined and content.breaking_change else '')
    ~ ': ' ~ content.subject -%}
{%- set selected = namespace(parts=[header]) -%}
{%- if content.body is defined -%}
{%- set selected.parts = selected.parts + [content.body | text_block] -%}
{%- endif -%}
{%- if content.breaking_description is defined -%}
{%- set selected.parts = selected.parts + ['BREAKING CHANGE: ' ~ (content.breaking_description | text_block)] -%}
{%- endif -%}
{%- if content.refs is defined -%}
{%- set selected.parts = selected.parts + ['Refs: ' ~ sections.issue_refs(content.refs)] -%}
{%- endif -%}
{%- if content.footer is defined -%}
{%- set selected.parts = selected.parts + [content.footer | text_block] -%}
{%- endif -%}
{{ sections.join(selected.parts) }}
{%- endblock %}
