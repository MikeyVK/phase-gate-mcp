{% extends "shared/templates/bases/tier2_markdown_tracking.jinja2" %}
{% import "shared/templates/patterns/markdown/sections.jinja2" as sections %}

{% block tracking_body -%}
{%- set selected = namespace(parts=[sections.prose('Problem', content.problem)]) -%}
{%- for field, title in [('summary', 'Summary'), ('expected', 'Expected Behavior'), ('actual', 'Actual Behavior'), ('context', 'Context')] -%}
{%- if content[field] is defined -%}
{%- set selected.parts = selected.parts + [sections.prose(title, content[field])] -%}
{%- endif -%}
{%- endfor -%}
{%- if content.reproduction_steps is defined -%}
{%- set selected.parts = selected.parts + [sections.join([
    sections.heading('Reproduction Steps'), sections.numbered(content.reproduction_steps)
])] -%}
{%- endif -%}
{{ sections.join(selected.parts) }}
{%- endblock %}
