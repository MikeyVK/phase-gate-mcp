{% extends "shared/templates/bases/tier2_markdown_document.jinja2" %}
{% import "shared/templates/patterns/markdown/sections.jinja2" as sections %}
{% import "shared/templates/patterns/markdown/links.jinja2" as links %}

{% block document_body -%}
{%- set selected = namespace(parts=[sections.prose('Summary', content.summary)]) -%}
{%- if content.key_changes is defined -%}
{%- set selected.parts = selected.parts + [sections.join([
    sections.heading('Key Changes'), sections.bullets(content.key_changes)
])] -%}
{%- endif -%}
{%- if content.migration_steps is defined -%}
{%- set selected.parts = selected.parts + [sections.join([
    sections.heading('Migration Steps'), sections.numbered(content.migration_steps)
])] -%}
{%- endif -%}
{%- if content.validation_checklist is defined -%}
{%- set selected.parts = selected.parts + [sections.join([
    sections.heading('Validation Checklist'), sections.checklist(content.validation_checklist)
])] -%}
{%- endif -%}
{%- if content.faq is defined -%}
{%- set selected.parts = selected.parts + [sections.heading('FAQ')] -%}
{%- for item in content.faq -%}
{%- set selected.parts = selected.parts + [sections.join([
    sections.heading(item.question, 3), item.answer | text_block
])] -%}
{%- endfor -%}
{%- endif -%}
{%- for item in content.sections | default([]) -%}
{%- set body = namespace(parts=[sections.heading(item.heading)]) -%}
{%- if item.content is defined -%}
{%- set body.parts = body.parts + [item.content | text_block] -%}
{%- endif -%}
{%- if item.bullets is defined -%}
{%- set body.parts = body.parts + [sections.bullets(item.bullets)] -%}
{%- endif -%}
{%- if item.checklist is defined -%}
{%- set body.parts = body.parts + [sections.checklist(item.checklist)] -%}
{%- endif -%}
{%- set selected.parts = selected.parts + [sections.join(body.parts)] -%}
{%- endfor -%}
{{ sections.join(selected.parts) }}
{%- endblock %}
