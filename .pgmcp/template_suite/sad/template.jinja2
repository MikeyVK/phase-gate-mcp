{% extends "shared/templates/bases/tier2_markdown_document.jinja2" %}
{% import "shared/templates/patterns/markdown/sections.jinja2" as sections %}
{% import "shared/templates/patterns/markdown/links.jinja2" as links %}

{% macro adr_index(records) -%}
{%- set rows = namespace(items=['| ADR | Status | Record |', '| --- | --- | --- |']) -%}
{%- for record in records -%}
{%- set rows.items = rows.items + [
    '| ' ~ sections.scalar_cell(record.adr_id) ~ ' | ' ~ sections.scalar_cell(record.status)
    ~ ' | ' ~ links.inline(record.link) ~ ' |'
] -%}
{%- endfor -%}
{{ rows.items | join('\n') }}
{%- endmacro %}

{% macro quality_scenarios(records) -%}
{%- set selected = namespace(parts=[]) -%}
{%- for record in records -%}
{%- set selected.parts = selected.parts + [
    sections.join([
        sections.heading(record.name, 4),
        sections.labelled('Scenario', record.scenario),
        sections.labelled('Response Measure', record.response_measure)
    ])
] -%}
{%- endfor -%}
{{ sections.join(selected.parts) }}
{%- endmacro %}

{% block document_body -%}
{%- set selected = namespace(parts=[
    sections.labelled('Architecture Scope', links.label(content.architecture_scope))
]) -%}
{%- for field, heading in [
    ('introduction_and_goals', '1. Introduction and Goals'),
    ('architecture_constraints', '2. Architecture Constraints'),
    ('context_and_scope', '3. Context and Scope'),
    ('solution_strategy', '4. Solution Strategy'),
    ('building_block_view', '5. Building Block View'),
    ('runtime_view', '6. Runtime View'),
    ('deployment_view', '7. Deployment View'),
    ('crosscutting_concepts', '8. Cross-cutting Concepts')
] -%}
{%- set selected.parts = selected.parts + [sections.prose(heading, content[field])] -%}
{%- endfor -%}
{%- set selected.parts = selected.parts + [
    sections.join([
        sections.heading('9. Architecture Decisions'),
        content.architecture_decisions.overview | text_block,
        adr_index(content.architecture_decisions.adrs)
    ]),
    sections.join([
        sections.heading('10. Quality Requirements'),
        sections.heading('10.1 Quality Requirements Overview', 3),
        content.quality_requirements.overview | text_block,
        sections.heading('10.2 Quality Scenarios', 3),
        quality_scenarios(content.quality_requirements.scenarios)
    ]),
    sections.prose('11. Risks and Technical Debts', content.risks_and_technical_debt),
    sections.prose('12. Glossary', content.glossary),
    sections.join([
        sections.heading('Template Attribution'),
        'Adapted from arc42 9.0-EN (July 2025) by Gernot Starke and Peter Hruschka. '
        ~ 'The distributed template adaptation is licensed under '
        ~ '[CC BY-SA 4.0](<https://creativecommons.org/licenses/by-sa/4.0/>). '
        ~ 'Changes: Markdown framing, proportional draft carriers, explicit ADR links, '
        ~ 'quality-scenario fields and pgmcp metadata. Caller-authored architecture content remains separately owned.',
        '[Pinned source](<https://github.com/arc42/arc42-template/blob/32fd461c91b184777e14f7d66b4e46db936fd3e5/EN/arc42-template.adoc>).'
    ])
] -%}
{{ sections.join(selected.parts) }}
{%- endblock %}
